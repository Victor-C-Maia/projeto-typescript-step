{
  "compilerOptions": {
    "target": "ES2022",
    // "target": "es6",
    "module": "NodeNext",
    // "module": "commonjs",  // deu erro
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist"]
}